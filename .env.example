# HuurRadar configuration.
#
# Copy to .env and fill in. Everything below is blank on purpose: nothing about
# any previous user ships in this repo. The app runs with almost all of it
# unset, it just does less.
#
#   npx huurradar init     writes this file for you
#
# NEVER commit your .env.


# ─── Server ──────────────────────────────────────────────────────────────────

PORT=3000
# Loopback by default. There is no TLS and no rate limiting here, so do not
# bind this to a public interface. Use a reverse proxy or a tunnel instead.
HOST=127.0.0.1

# Where the SQLite database and logs are written. Defaults to ./data
# HUURRADAR_DATA_DIR=


# ─── First login ─────────────────────────────────────────────────────────────

# Username created on first start. Defaults to "admin".
# HUURRADAR_SEED_USER=

# Password for that account. If you leave this blank a random one is generated
# and printed to the console on first start. Change it after logging in.
# HUURRADAR_SEED_PASSWORD=


# ─── What you are looking for ────────────────────────────────────────────────

# REQUIRED. Where to search, as a semicolon-separated list of City:lat:lng.
#
#   SEARCH_AREAS=Utrecht:52.0907:5.1214;Amersfoort:52.1561:5.3878
#
# Coordinates are optional per entry, but MVGM and Brockhoff encode the search
# centre as a coordinate and are skipped for any area without one. Get a
# coordinate by right-clicking a spot in Google Maps.
SEARCH_AREAS=

# Radius around each area, in km.
SEARCH_RADIUS_KM=10

# Result pages fetched per platform per area. Keep this low.
MAX_PAGES_PER_PLATFORM=5

# Cities you will actually consider, comma-separated. Matched case-insensitively
# as a substring, so "amsterdam" also keeps "Amsterdam-Duivendrecht". This is a
# second filter on top of SEARCH_AREAS, useful when a radius pulls in a
# neighbouring town you do not want.
# Leave EMPTY to accept every city the platforms return.
ALLOWED_CITIES=

# Override the User-Agent the scrapers send. Optional.
# SCRAPER_USER_AGENT=

# Starting criteria applied to every platform on first run. You can tune each
# platform individually from the Scrapers page in the dashboard afterwards.
DEFAULT_MIN_ROOMS=2
DEFAULT_MIN_LIVING_AREA=40
DEFAULT_MAX_PRICE=2000

# How often to poll every enabled platform, in minutes. Minimum 5.
# These are other people's servers. 15 is already fast enough to beat most
# people to a new listing.
SCRAPE_INTERVAL_MINUTES=15

# Set to false to skip the immediate scrape on startup.
# SCRAPE_ON_START=true


# ─── Email notifications ─────────────────────────────────────────────────────
#
# Any SMTP server. For Gmail you need an App Password, not your login password.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Seeded into the recipients table on first run. You can manage recipients from
# the dashboard afterwards.
NOTIFICATION_EMAIL=
NOTIFICATION_EMAIL_CC=


# ─── AI analysis (optional) ──────────────────────────────────────────────────
#
# A Gemini API key from https://aistudio.google.com/apikey. Without it the app
# still finds and notifies, it just will not read income requirements off the
# listing page or write motivation letters.

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Your household's combined gross ANNUAL income in euros. Optional. Set it and
# the AI tells you whether you meet a listing's income requirement. Leave it
# blank and it just reports what the listing asks for.
COMBINED_GROSS_INCOME=

# Number of people in the household. Optional, helps the eligibility read.
HOUSEHOLD_SIZE=

# Rent at or below this always notifies you, whatever the AI concludes about
# income caps. Useful because a middenhuur cap is often negotiable and you would
# rather see the listing than have it filtered away. Leave blank for no override.
ALWAYS_NOTIFY_MAX_PRICE=


# ─── Motivation letters (optional) ───────────────────────────────────────────
#
# Used by the letter generator and by auto-apply. Write this yourself, in your
# own words. The model is instructed to use ONLY what you put here and to invent
# nothing, so anything you leave out simply will not appear in the letter.
#
# Example of the KIND of thing that belongs here (replace all of it):
#   We are a couple in our late twenties, both on permanent contracts, moving
#   out of a shared flat. Combined gross income around EUR X per year. We are
#   looking for somewhere long term and we have no pets.

APPLICANT_PROFILE=

# nl or en. Defaults to nl.
LETTER_LANGUAGE=nl

# Maximum letter length in characters. Defaults to 900.
LETTER_MAX_CHARS=900

# How to sign off, e.g. "Kind regards, <your names>". Optional.
LETTER_SIGNATURE=

# Optional. A full letter template. If set, the model keeps your structure and
# tone and only adapts the property-specific details. Use \n for line breaks.
LETTER_TEMPLATE=


# ─── Auto-apply (optional, Brockhoff only) ───────────────────────────────────
#
# Submits a real rental application on your behalf, using Playwright to drive a
# browser and 2captcha to solve the reCAPTCHA on the form.
#
# READ THIS BEFORE ENABLING IT:
#   - It sends a real application to a real letting agent with your real name
#     and contact details. There is no undo.
#   - Automated form submission and CAPTCHA solving may breach the site's terms
#     of service. Check them. This is your decision and your responsibility.
#   - Solving CAPTCHAs through a paid service costs money per solve.
#
# Leave CAPTCHA_API_KEY blank and the whole feature stays off.

CAPTCHA_API_KEY=

# Required when auto-apply is enabled. No defaults: the app refuses to submit
# a form rather than guess who you are.
APPLICANT_NAME=
APPLICANT_EMAIL=
APPLICANT_PHONE=
# man or vrouw
APPLICANT_GENDER=
